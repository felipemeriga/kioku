{
  "name": "agentic-rag",
  "version": "0.1.0",
  "description": "CLI for wiring a local repo to your agentic-rag second-brain — installs the MCP, session-start hook, and CLAUDE.md snippet.",
  "type": "module",
  "bin": {
    "agentic-rag": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
