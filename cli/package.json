{
  "name": "@felipemeriga/kioku",
  "version": "0.7.0",
  "description": "Kioku (\u8a18\u61b6) \u2014 second brain for your repos. Wires a local repo to your Kioku instance: MCP server, SessionStart hook, CLAUDE.md snippet.",
  "type": "module",
  "license": "MIT",
  "author": "felipemeriga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipemeriga/kioku.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/felipemeriga/kioku#readme",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "second-brain",
    "memory",
    "code-graph"
  ],
  "bin": {
    "kioku": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "npm run build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "boxen": "^7.1.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2"
  },
  "engines": {
    "node": ">=18"
  }
}
