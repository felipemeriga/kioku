# Local-dev env for backend.
# Copy to backend/.env.local and fill in values from `supabase status`.
# backend/run_local.sh loads this file before starting uvicorn.

# Local Supabase stack (from `supabase status --output env`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=<paste SERVICE_ROLE_KEY from `supabase status --output env`>
SUPABASE_JWT_SECRET=<paste JWT_SECRET from `supabase status --output env`>

# Real Anthropic + Voyage keys (same as backend/.env)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Optional — used only if you exercise the corresponding code paths:
TAVILY_API_KEY=
OPENAI_API_KEY=
MCP_API_KEY=

# Tracing off for local dev (avoid polluting the prod LangSmith project)
LANGCHAIN_TRACING_V2=false
