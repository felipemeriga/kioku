# Obol Ledger configuration (see obol_ledger/config.py)
OBOL_LEDGER_HOST=0.0.0.0
OBOL_LEDGER_PORT=8081

# Base URL of the obol-gateway service. The payout builder calls
# POST {OBOL_GATEWAY_URL}/v1/payouts to actually move money.
OBOL_GATEWAY_URL=http://localhost:8080

# Bearer token used for internal gateway calls (optional).
OBOL_GATEWAY_TOKEN=

# Outbound HTTP timeout in seconds for gateway calls.
OBOL_GATEWAY_TIMEOUT=10.0

# Default reporting currency for chart-of-accounts sanity checks.
OBOL_DEFAULT_CURRENCY=EUR
