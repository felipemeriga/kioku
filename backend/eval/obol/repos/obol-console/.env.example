# ---------------------------------------------------------------------------
# obol-console — environment configuration
# ---------------------------------------------------------------------------
# The BFF is the only tier that talks to the upstream Obol services. The web
# SPA only ever talks to the BFF (same-origin under /api), never to gateway or
# ledger directly.

# --- BFF server ---
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# --- Upstream: obol-gateway (Go) — charges, refunds, payouts ---
# Refunds are proxied here: POST /v1/charges/{id}/refunds
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_API_KEY=obol_gw_test_key

# --- Upstream: obol-ledger (Python/FastAPI) — balances, statements, batches ---
# Balances are proxied here: GET /v1/accounts/{id}/balance
LEDGER_BASE_URL=http://localhost:8000
LEDGER_API_KEY=obol_lg_test_key

# --- Timeouts (ms) for upstream calls ---
UPSTREAM_TIMEOUT_MS=8000

# --- Operator identity injected on every proxied request (audit trail) ---
CONSOLE_PLATFORM_ID=plat_marisqueira

# --- Web SPA (Vite) ---
# Base path the SPA uses to reach the BFF. Left relative so the dev proxy and
# production reverse-proxy both work.
VITE_BFF_BASE_URL=/api
