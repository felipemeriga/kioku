{
  "name": "@obol/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/contracts/index.js",
  "module": "./dist/contracts/index.js",
  "types": "./dist/contracts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contracts/index.d.ts",
