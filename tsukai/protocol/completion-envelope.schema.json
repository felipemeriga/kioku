{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "completed",
        "needs_input",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "data": {
      "default": null,
      "title": "Data"
    },
    "missing_inputs": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "failure": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "outcome"
  ],
  "title": "CompletionEnvelope",
  "type": "object"
}
