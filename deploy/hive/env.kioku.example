# Append to the hive .env. DOMAIN + ACME_EMAIL already exist there.
# Values come from the agentic-rag Supabase project + your API keys.

KIOKU_ANTHROPIC_API_KEY=
KIOKU_VOYAGE_API_KEY=
KIOKU_TAVILY_API_KEY=

# Supabase (the agentic-rag project — REST/service-key path, always valid)
KIOKU_SUPABASE_URL=
KIOKU_SUPABASE_SERVICE_KEY=
KIOKU_SUPABASE_JWT_SECRET=

# mem0: a WORKING direct Postgres connection to the same DB (mem0 schema).
# NOT the app service-key — a real postgres:// URL (Supabase → Database →
# Connection string → URI). This is the credential that must not be stale.
KIOKU_MEM0_DATABASE_URL=
KIOKU_MEM0_SERVICE_TOKEN=

# MCP: a shared secret the MCP server accepts; the CLI uses per-repo api keys.
KIOKU_MCP_API_KEY=

# Legacy Fernet key — now only a read-only fallback for any pre-KMS rows.
# At-rest secrets are encrypted with AWS KMS (below); this can be removed once
# you're sure no Fernet-format rows remain.
KIOKU_NOTION_TOKEN_ENCRYPTION_KEY=

# AWS KMS — encrypts at-rest secrets (SSH private keys, Notion tokens, API keys).
# Use the dedicated, KMS-only, IP-allowlisted IAM user (NOT an admin key).
# These are referenced directly (not KIOKU_-prefixed) by the compose files.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KIOKU_KMS_KEY_ID=   # the KMS key ARN, e.g. arn:aws:kms:us-east-1:...:key/...
